{
  "schema": 1,
  "release": "alpha3",
  "steering": [
    "steering/product.md",
    "steering/tech.md",
    "steering/architecture.md",
    "steering/security.md",
    "steering/non-functional.md",
    "steering/database.md",
    "steering/api-standards.md"
  ],
  "docs": [
    "docs/code-design.md",
    "docs/architecture/data-model.md",
    "docs/architecture/system-overview.md"
  ],
  "phases": {
    "intake": {
      "number": 1,
      "generate": "requirement-intake-generate",
      "repair": "requirement-intake-revise",
      "call": "requirements-init",
      "outputs": [
        ".aidd/requirement-list.md"
      ],
      "upstream": [],
      "per_feature": false
    },
    "steering": {
      "number": 2,
      "generate": "steering-authoring-generate",
      "repair": "steering-authoring-revise",
      "call": "requirements-init",
      "outputs": [
        "steering/product.md",
        "steering/tech.md",
        "steering/architecture.md",
        "steering/security.md",
        "steering/non-functional.md",
        "steering/database.md",
        "steering/api-standards.md"
      ],
      "upstream": [
        ".aidd/requirement-list.md"
      ],
      "per_feature": false
    },
    "feature": {
      "number": 3,
      "generate": "feature-decomposition-generate",
      "repair": "feature-decomposition-revise",
      "call": "requirements-init",
      "outputs": [
        ".aidd/feature-list.md"
      ],
      "upstream": [
        ".aidd/requirement-list.md",
        "steering/product.md",
        "steering/tech.md",
        "steering/architecture.md",
        "steering/security.md",
        "steering/non-functional.md",
        "steering/database.md",
        "steering/api-standards.md"
      ],
      "per_feature": false
    },
    "requirements": {
      "number": 4,
      "generate": "requirements-authoring-generate",
      "repair": "requirements-authoring-revise",
      "call": "requirements",
      "outputs": [
        "specs/{feature}/requirements.md"
      ],
      "upstream": [
        ".aidd/requirement-list.md",
        ".aidd/feature-list.md",
        "steering/product.md",
        "steering/tech.md",
        "steering/architecture.md",
        "steering/security.md",
        "steering/non-functional.md",
        "steering/database.md",
        "steering/api-standards.md"
      ],
      "per_feature": true
    },
    "design": {
      "number": 5,
      "generate": "design-authoring-generate",
      "repair": "design-authoring-revise",
      "call": "design",
      "outputs": [
        "specs/{feature}/design.md"
      ],
      "upstream": [
        ".aidd/feature-list.md",
        "steering/product.md",
        "steering/tech.md",
        "steering/architecture.md",
        "steering/security.md",
        "steering/non-functional.md",
        "steering/database.md",
        "steering/api-standards.md"
      ],
      "per_feature": true
    },
    "docs": {
      "number": 6,
      "generate": "docs-integration-generate",
      "repair": "docs-integration-revise",
      "call": "docs",
      "outputs": [
        "docs/code-design.md",
        "docs/architecture/data-model.md",
        "docs/architecture/system-overview.md"
      ],
      "upstream": [
        ".aidd/feature-list.md",
        "steering/product.md",
        "steering/tech.md",
        "steering/architecture.md",
        "steering/security.md",
        "steering/non-functional.md",
        "steering/database.md",
        "steering/api-standards.md"
      ],
      "per_feature": false
    },
    "tasks": {
      "number": 7,
      "generate": "tasks-authoring-generate",
      "repair": "tasks-authoring-revise",
      "call": "tasks",
      "outputs": [
        "specs/{feature}/tasks.md"
      ],
      "upstream": [
        ".aidd/feature-list.md",
        "steering/product.md",
        "steering/tech.md",
        "steering/architecture.md",
        "steering/security.md",
        "steering/non-functional.md",
        "steering/database.md",
        "steering/api-standards.md",
        "docs/code-design.md",
        "docs/architecture/data-model.md",
        "docs/architecture/system-overview.md"
      ],
      "per_feature": true
    },
    "implement": {
      "number": 8,
      "generate": "implement-authoring-generate",
      "repair": "implement-authoring-revise",
      "call": "implement-task",
      "flows": {
        "generate": "implement-task",
        "repair": "implement-task",
        "review": "implement-review"
      },
      "outputs": [
        ".aidd/implementation/features/{feature}/review.json"
      ],
      "upstream": [],
      "per_feature": true,
      "profile": "implementation-code-v1"
    }
  }
}
