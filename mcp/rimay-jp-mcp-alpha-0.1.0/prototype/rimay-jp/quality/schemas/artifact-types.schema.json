{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-assets/contracts/artifact-types.schema.json",
  "title": "Artifact-Type Registry (knowledge/artifact-types.yaml)",
  "description": "Declares the seven supported artifact types and how the engine routes to each type's Layer 1 structure and Layer 2 catalog. Read by the artifact-type registry, the Layer 1 provider, and the engine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "types"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "layer1_structure", "layer2_catalog_dir", "definition_source_id", "implementable", "grounding_status"],
        "properties": {
          "id": {
            "type": "string",
            "description": "The six in-scope types (FR-032/FR-045). 'requirement_set' is out of scope (no structure schema).",
            "enum": ["functional", "acceptance_criteria", "non_functional", "user_story", "constraint", "glossary_term"]
          },
          "name": { "type": "string", "minLength": 1 },
          "layer1_structure": { "type": "string", "pattern": "^knowledge/layer1/.+/structure\\.yaml$" },
          "layer2_catalog_dir": { "type": "string", "pattern": "^knowledge/layer2/.+" },
          "definition_source_id": { "type": "string", "pattern": "^[a-z_]+/[a-z0-9-]+-[0-9]{4}$" },
          "implementable": { "type": "string", "enum": ["deterministic", "judgment", "mixed"] },
          "grounding_status": {
            "type": "string",
            "enum": ["grounded", "pending_source", "partial"],
            "description": "'grounded' = sources retained + deterministic catalog ships; 'pending_source' = definition source not yet retained; 'partial' = some deterministic rules ship while others are deferred."
          }
        }
      }
    }
  }
}
