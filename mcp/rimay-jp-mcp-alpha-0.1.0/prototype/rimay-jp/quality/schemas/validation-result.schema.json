{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-assets/contracts/validation-result.schema.json",
  "title": "Validation Result",
  "description": "Output of Layer 2 validation for a single requirement, plus the batch wrapper.",
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment", "start", "end", "text"],
      "properties": {
        "segment": { "type": "string", "enum": ["scope", "condition", "system_response", "whole_requirement"] },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smell", "smell_name", "quality_attribute", "location", "severity", "explanation", "citation", "rule_id"],
      "properties": {
        "smell": {
          "type": "string",
          "enum": [
            "non_atomic_requirement", "incomplete_requirement", "incorrect_order_requirement",
            "coordination_ambiguity", "not_a_requirement", "incomplete_condition",
            "incomplete_system_response", "passive_voice", "not_precise_verb"
          ]
        },
        "smell_name": { "type": "string" },
        "quality_attribute": { "type": "string", "enum": ["completeness", "clarity", "atomicity", "correctness"] },
        "location": { "$ref": "#/$defs/location" },
        "severity": { "type": "string", "enum": ["high", "medium", "low"] },
        "explanation": { "type": "string", "minLength": 1 },
        "citation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["document", "locator"],
          "properties": {
            "document": { "type": "string" },
            "locator": { "type": "string" }
          }
        },
        "rule_id": { "type": "string" }
      }
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "verdict", "analyzable", "findings"],
      "properties": {
        "language": { "type": "string", "enum": ["en", "ja", "undetermined"] },
        "verdict": { "type": "string", "enum": ["pass", "fail"] },
        "analyzable": { "type": "boolean" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "notes": { "type": "string" }
      }
    }
  },
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/validationResult" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["results", "summary"],
      "properties": {
        "results": { "type": "array", "items": { "$ref": "#/$defs/validationResult" } },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed", "by_smell"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "by_smell": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
          }
        }
      }
    }
  ]
}
