{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-assets/contracts/rule.schema.json",
  "title": "Layer 2 Smell Rule",
  "description": "Self-contained, source-cited smell-detection rule. One per smell per language. A rule that fails this schema (e.g., missing citation or examples) is rejected at load time (FR-024).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "language", "quality_attribute", "definition", "citation", "detector", "default_severity", "explanation_template", "examples"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Smell id; MUST be one of the nine catalog ids.",
      "enum": [
        "non_atomic_requirement",
        "incomplete_requirement",
        "incorrect_order_requirement",
        "coordination_ambiguity",
        "not_a_requirement",
        "incomplete_condition",
        "incomplete_system_response",
        "passive_voice",
        "not_precise_verb"
      ]
    },
    "name": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "enum": ["en", "ja"] },
    "quality_attribute": {
      "type": "string",
      "enum": ["completeness", "clarity", "atomicity", "correctness"]
    },
    "definition": { "type": "string", "minLength": 1 },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "locator"],
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1, "description": "Section/table/figure precise enough to find the supporting passage." }
      }
    },
    "detection_basis": {
      "type": "object",
      "description": "Required when language = ja: documents/cites the Japanese linguistic realization (FR-020).",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "citation": { "type": "string" }
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "params"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Generic primitive the engine provides. Adding a rule that uses an existing type needs no engine change (FR-022).",
          "enum": ["segment_count", "completeness", "passive_voice", "glossary"]
        },
        "params": { "type": "object" }
      }
    },
    "default_severity": { "type": "string", "enum": ["high", "medium", "low"] },
    "explanation_template": { "type": "string", "minLength": 1 },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 1,
          "description": "Requirements this rule MUST flag (its tests).",
          "items": { "type": "string", "minLength": 1 }
        },
        "negative": {
          "type": "array",
          "minItems": 1,
          "description": "Requirements this rule MUST NOT flag (its tests).",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "language": { "const": "ja" } } },
      "then": { "required": ["detection_basis"] }
    }
  ]
}
