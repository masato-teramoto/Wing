{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rimay-jp.example/schemas/experience-record.schema.json",
  "title": "Experience Record (RQK-E/experience) v0.1",
  "description": "Experience Storeの追記型一次記録。canonical_revision/patch_applied/validation_report/approval/feedbackが一次記録、reference/promotionがgovernance記録（参照履歴・昇格）。ストアが唯一の正本であり、Projectionと参照・昇格状態はレコードから100%再構築できなければならない（ADR-0012 D4、Step 7 Gate）。",
  "type": "object",
  "required": ["record_id", "kind", "payload"],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{6}$"
    },
    "kind": {
      "enum": ["canonical_revision", "patch_applied", "validation_report",
               "approval", "feedback", "reference", "promotion"]
    },
    "requirement_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
