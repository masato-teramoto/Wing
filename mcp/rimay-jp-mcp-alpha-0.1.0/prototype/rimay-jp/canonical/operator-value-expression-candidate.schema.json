{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rimay-jp/operator-value-expression-candidate.schema.json",
  "title": "Rimay-JP Operator Value Expression Candidate",
  "type": "object",
  "required": ["candidate_version", "target_canonical_version", "condition"],
  "additionalProperties": false,
  "properties": {
    "candidate_version": { "const": "0.1.0" },
    "target_canonical_version": { "const": "1.1.0-candidate" },
    "condition": { "$ref": "#/$defs/condition" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "span": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "declaredReference": {
      "type": "object",
      "required": ["wrapper", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "wrapper": { "const": "declared_reference" },
        "kind": { "enum": ["actor", "class", "property"] },
        "name": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "typeReference": {
      "type": "object",
      "required": ["kind", "name"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["class", "label"] },
        "name": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "instanceOrProperty": {
      "type": "object",
      "required": ["wrapper", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "wrapper": { "const": "instance_or_property" },
        "kind": { "const": "instance_or_property" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "defined_in_type": { "$ref": "#/$defs/typeReference" },
        "label": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "uiComponentInstance": {
      "type": "object",
      "required": ["wrapper", "kind", "name", "component_type"],
      "additionalProperties": false,
      "properties": {
        "wrapper": { "const": "ui_component_instance" },
        "kind": { "const": "ui_component_instance" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "component_type": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "operand": {
      "oneOf": [
        { "$ref": "#/$defs/declaredReference" },
        { "$ref": "#/$defs/instanceOrProperty" },
        { "$ref": "#/$defs/uiComponentInstance" }
      ]
    },
    "valueExpression": {
      "oneOf": [
        { "$ref": "#/$defs/valueLeaf" },
        { "$ref": "#/$defs/valueGroup" },
        { "$ref": "#/$defs/valueAnd" },
        { "$ref": "#/$defs/valueOr" }
      ]
    },
    "valueLeaf": {
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "value" },
        "value": { "$ref": "#/$defs/nonEmpty" },
        "unit": { "const": "JPY" }
      }
    },
    "valueGroup": {
      "type": "object",
      "required": ["kind", "expression"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "group" },
        "expression": { "$ref": "#/$defs/valueExpression" }
      }
    },
    "valueAnd": {
      "type": "object",
      "required": ["kind", "left", "right"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "and" },
        "left": { "$ref": "#/$defs/valueExpression" },
        "right": { "$ref": "#/$defs/valueExpression" }
      }
    },
    "valueOr": {
      "type": "object",
      "required": ["kind", "left", "right"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "or" },
        "left": { "$ref": "#/$defs/valueExpression" },
        "right": { "$ref": "#/$defs/valueExpression" }
      }
    },
    "predicate": {
      "type": "object",
      "required": ["operand", "operator", "value_expression"],
      "additionalProperties": false,
      "properties": {
        "operand": { "$ref": "#/$defs/operand" },
        "operator": {
          "enum": ["IS", "EQUALS", "NOT_EQUALS", "GREATER_THAN", "LESS_THAN", "GREATER_OR_EQUAL", "LESS_OR_EQUAL", "CONTAINS"]
        },
        "value_expression": { "$ref": "#/$defs/valueExpression" }
      }
    },
    "operandResolution": {
      "type": "object",
      "required": ["status", "symbol_id", "declaration_rule"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["resolved", "explicit_disjunction"] },
        "symbol_id": { "type": ["string", "null"] },
        "declaration_rule": { "type": ["string", "null"] }
      }
    },
    "repositoryTrace": {
      "type": "object",
      "required": ["repository_rule_id", "source_span", "source", "grammar_source_sha256", "operand_resolution"],
      "additionalProperties": false,
      "properties": {
        "repository_rule_id": {
          "enum": ["ActorOrTypeOrPropertyOperatorElement", "InstanceOrPropertyOperatorValue", "UIComponentInstanceOperatorElement"]
        },
        "source_span": { "$ref": "#/$defs/span" },
        "source": { "type": "string" },
        "grammar_source_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "operand_resolution": { "$ref": "#/$defs/operandResolution" }
      }
    },
    "condition": {
      "type": "object",
      "required": ["type", "predicate"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["IF", "WHILE"] },
        "predicate": { "$ref": "#/$defs/predicate" },
        "repository_trace": { "$ref": "#/$defs/repositoryTrace" }
      }
    }
  }
}
