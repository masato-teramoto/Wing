{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rimay-jp/validation-rule.schema.json",
  "title": "Validation Rule and Finding Contract",
  "description": "Validator規則定義と、全Validator共通のfinding出力契約（構想書v0.5 §15・§16）。findingのpathは単一ノードのCanonicalPointer。fix_candidatesは辞書・格フレーム・業務ルールに根拠を持つものだけを返し、statusは常にproposed（自動confirmed禁止）。",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "rule_set_version": { "type": "string" },
    "profile_version": { "type": "string" },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/validationRule" }
    }
  },
  "$defs": {
    "canonicalPointer": {
      "type": "string",
      "pattern": "^(/([^/~*]|~[01])*)+$"
    },
    "ruleSelector": {
      "type": "string",
      "pattern": "^(/([^/~]|~[01])*)+$"
    },
    "validationRule": {
      "type": "object",
      "required": ["id", "validator", "finding_code", "severity", "blocking", "message_template"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^VR-[A-Z0-9-]+$" },
        "version": { "type": "string" },
        "validator": {
          "enum": ["core", "terminology", "domain", "sidecar"],
          "description": "validate_core（Schema・格・品質）／validate_terminology／validate_domain／validate_sidecar"
        },
        "finding_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z-]+$",
          "description": "finding-code-catalog.yamlに登録されたコードのみ使用可"
        },
        "severity": { "enum": ["error", "warning", "info"] },
        "blocking": {
          "type": "boolean",
          "description": "trueのfindingが1件でもあればreview_readyへ遷移できない"
        },
        "applies_to": { "$ref": "#/$defs/ruleSelector" },
        "message_template": { "type": "string" },
        "rationale": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "description": "全Validatorの共通出力。transientでありcanonical_hashの対象外",
      "required": ["code", "severity", "blocking", "message"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z-]+$" },
        "rule_id": { "type": "string" },
        "severity": { "enum": ["error", "warning", "info"] },
        "blocking": { "type": "boolean" },
        "path": { "$ref": "#/$defs/canonicalPointer" },
        "message": { "type": "string" },
        "evidence": {
          "type": "object",
          "description": "検出根拠（格フレームID・辞書検索結果・期待値等）"
        },
        "fix_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "source", "status"],
            "additionalProperties": false,
            "properties": {
              "value": {},
              "source": { "type": "string", "description": "根拠参照（term:X、rule:Y、case-frame:Z等）" },
              "status": { "const": "proposed" }
            }
          }
        }
      }
    }
  }
}
