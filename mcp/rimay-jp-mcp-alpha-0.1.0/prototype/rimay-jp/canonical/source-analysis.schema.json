{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rimay-jp/source-analysis.schema.json",
  "title": "Source Analysis Output (Phase 3A structured output)",
  "description": "情報分類・要求候補抽出の出力契約。ルールベース実装とLLM実装（Phase 3C以降）の双方がこの契約に適合する。LLM実装でも確定（confirmed）は生成できず、抽出値はproposed、欠落はunknownとして返す。",
  "type": "object",
  "required": ["segment", "classification", "rationale", "extraction_mode"],
  "additionalProperties": false,
  "properties": {
    "segment": {
      "type": "object",
      "required": ["document_id", "text"],
      "additionalProperties": false,
      "properties": {
        "document_id": { "type": "string" },
        "section_id": { "type": "string" },
        "text": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "page": { "type": "integer" },
            "paragraph": { "type": "integer" }
          }
        }
      }
    },
    "classification": {
      "enum": ["context", "problem", "goal", "stakeholder_view", "assumption",
               "issue", "decision", "business_rule", "requirement_candidate"]
    },
    "rationale": {
      "type": "string",
      "description": "分類根拠（一致したシグナル、またはLLMの判断根拠）。必須"
    },
    "strength": { "enum": ["strong", "weak", "fallback"] },
    "extraction_mode": {
      "enum": ["none", "strict", "heuristic", "llm"],
      "description": "none=Rimay化対象外。strict=制約付き日本語として受理。heuristic/llm=部分抽出"
    },
    "canonical": {
      "description": "requirement_candidateのみ。canonical-requirement.schema.jsonに適合すること",
      "type": ["object", "null"]
    }
  }
}
