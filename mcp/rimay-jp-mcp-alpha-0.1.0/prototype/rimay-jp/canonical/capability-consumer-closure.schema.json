{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rimay-jp/capability-consumer-closure.schema.json",
  "title": "Capability Consumer Closure Supplement",
  "description": "採用・runtime active・必須consumer workflow完結を分離して記録する追加証跡。",
  "type": "object",
  "required": [
    "contract_version",
    "supplement_id",
    "recorded_at",
    "governance_ruling_ref",
    "capability_id",
    "product_adoption_binding",
    "runtime_activation_binding",
    "consumer_registry_binding",
    "state",
    "consumer_closure",
    "closure_signature"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "const": "0.1.0" },
    "supplement_id": {
      "type": "string",
      "pattern": "^CCSUP-[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "governance_ruling_ref": {
      "type": "string",
      "pattern": "^RC-[0-9]{3}$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^CAP-[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "product_adoption_binding": { "$ref": "#/$defs/productAdoptionBinding" },
    "runtime_activation_binding": { "$ref": "#/$defs/runtimeActivationBinding" },
    "consumer_registry_binding": { "$ref": "#/$defs/consumerRegistryBinding" },
    "state": { "$ref": "#/$defs/state" },
    "consumer_closure": { "$ref": "#/$defs/consumerClosure" },
    "closure_signature": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(/([^/~]|~[01])*)+$"
    },
    "artifactRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "selector": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifactRef" }
    },
    "productAdoptionBinding": {
      "type": "object",
      "required": ["path", "sha256", "plan_id", "decision_id", "product_signature"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "plan_id": {
          "type": "string",
          "pattern": "^RPADP-[A-Za-z0-9][A-Za-z0-9-]*$"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^B5P-[A-Za-z0-9][A-Za-z0-9-]*$"
        },
        "product_signature": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtimeActivationBinding": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "capability_pointer",
        "product_signature_pointer",
        "ruling_pointer",
        "runtime_status_pointer",
        "ruling_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "capability_pointer": { "$ref": "#/$defs/jsonPointer" },
        "product_signature_pointer": { "$ref": "#/$defs/jsonPointer" },
        "ruling_pointer": { "$ref": "#/$defs/jsonPointer" },
        "runtime_status_pointer": { "$ref": "#/$defs/jsonPointer" },
        "ruling_ref": {
          "type": "string",
          "pattern": "^RC-[0-9]{3}$"
        }
      }
    },
    "consumerRegistryBinding": {
      "type": "object",
      "required": ["path", "sha256", "registry_signature"],
      "additionalProperties": false,
      "properties": {
        "path": { "const": "profile/production-consumers.yaml" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "registry_signature": { "$ref": "#/$defs/sha256" }
      }
    },
    "state": {
      "type": "object",
      "required": ["adoption", "runtime", "workflow"],
      "additionalProperties": false,
      "properties": {
        "adoption": { "const": "adopted" },
        "runtime": { "const": "runtime_active" },
        "workflow": { "enum": ["workflow_complete", "workflow_incomplete"] }
      }
    },
    "consumerClosure": {
      "type": "object",
      "required": ["consumers", "composition_cases", "summary"],
      "additionalProperties": false,
      "properties": {
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/consumerClosureEntry" }
        },
        "composition_cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/compositionCase" }
        },
        "summary": { "$ref": "#/$defs/closureSummary" }
      }
    },
    "consumerClosureEntry": {
      "type": "object",
      "required": [
        "consumer_id",
        "path",
        "criticality",
        "disposition",
        "rationale",
        "implemented_shape_ids",
        "deferred_shape_ids",
        "fixture_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "consumer_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "path": { "$ref": "#/$defs/relativePath" },
        "criticality": {
          "enum": [
            "required_workflow",
            "optional_consumer",
            "non_producer_or_governance"
          ]
        },
        "disposition": {
          "enum": ["implemented_verified", "not_applicable", "fail_closed_deferred"]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "implemented_shape_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
        },
        "deferred_shape_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
        },
        "fixture_refs": { "$ref": "#/$defs/artifactRefs" }
      }
    },
    "compositionCase": {
      "type": "object",
      "required": [
        "composition_id",
        "required_for_workflow",
        "consumer_ids",
        "status",
        "rationale",
        "fixture_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "composition_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "required_for_workflow": { "type": "boolean" },
        "consumer_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
        },
        "status": {
          "enum": ["implemented_verified", "not_applicable", "fail_closed_deferred"]
        },
        "diagnostic_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "rationale": { "type": "string", "minLength": 1 },
        "fixture_refs": { "$ref": "#/$defs/artifactRefs" }
      }
    },
    "closureSummary": {
      "type": "object",
      "required": [
        "required_workflow_total",
        "required_workflow_implemented",
        "required_workflow_deferred",
        "required_compositions_total",
        "required_compositions_implemented",
        "required_compositions_deferred"
      ],
      "additionalProperties": false,
      "properties": {
        "required_workflow_total": { "type": "integer", "minimum": 0 },
        "required_workflow_implemented": { "type": "integer", "minimum": 0 },
        "required_workflow_deferred": { "type": "integer", "minimum": 0 },
        "required_compositions_total": { "type": "integer", "minimum": 0 },
        "required_compositions_implemented": { "type": "integer", "minimum": 0 },
        "required_compositions_deferred": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
