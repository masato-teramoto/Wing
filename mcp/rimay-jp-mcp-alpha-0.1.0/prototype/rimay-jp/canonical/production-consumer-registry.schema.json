{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rimay-jp/production-consumer-registry.schema.json",
  "title": "Rimay-JP Production Consumer Registry",
  "description": "Capability consumer closureが全件分類すべきproduction consumerの閉じた台帳。",
  "type": "object",
  "required": ["registry_version", "recorded_at", "consumers", "registry_signature"],
  "additionalProperties": false,
  "properties": {
    "registry_version": { "const": "0.1.0" },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["consumer_id", "path", "criticality", "role"],
        "additionalProperties": false,
        "properties": {
          "consumer_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
          },
          "criticality": {
            "enum": [
              "required_workflow",
              "optional_consumer",
              "non_producer_or_governance"
            ]
          },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "registry_signature": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
