{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rimay-jp/canonical-patch.schema.json",
  "title": "Canonical Patch",
  "description": "Canonical Requirementへの唯一の更新手段（構想書v0.5 §14.13）。LLMはCanonical全体を再生成せず、本Schemaに適合するPatchだけを生成する。pathは単一ノードのCanonicalPointer（RuleSelector不可）。base_revisionが適用時点のrevisionと一致しない場合はPATCH-INVALID（reason: revision_conflict）として拒否する。",
  "type": "object",
  "required": ["operation", "requirement_id", "base_revision", "path", "evidence"],
  "additionalProperties": false,
  "properties": {
    "operation": {
      "enum": ["replace_slot", "confirm_slot", "mark_not_applicable", "revert_slot"]
    },
    "requirement_id": { "type": "string", "pattern": "^REQ-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "base_revision": { "type": "integer", "minimum": 1 },
    "path": {
      "type": "string",
      "description": "単一ノードのCanonicalPointer（RFC 6901厳密準拠、'*'不可）。operandとvalue_expressionは専用Patch Rule採用まで編集不可。",
      "pattern": "^(/([^/~*]|~[01])*)+$",
      "not": {
        "pattern": "(^|/)(operand|value_expression)(/|$)"
      }
    },
    "expected_status": {
      "enum": ["unknown", "proposed", "confirmed", "not_applicable"],
      "description": "適用前の期待スロット状態。不一致は拒否"
    },
    "old_value": { "description": "適用前の値（unknownの場合はnull）" },
    "new_value": { "description": "replace_slotで必須" },
    "old_status": { "enum": ["unknown", "proposed", "confirmed", "not_applicable"] },
    "new_status": { "enum": ["unknown", "proposed", "confirmed", "not_applicable"] },
    "evidence": {
      "type": "object",
      "required": ["type", "reference"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["tool_result", "user_answer", "knowledge_asset", "requirement_text", "rule"] },
        "reference": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "replace_slot" } } },
      "then": {
        "required": ["new_value", "new_status"],
        "properties": {
          "new_status": {
            "enum": ["proposed", "confirmed"],
            "description": "confirmedはevidence.typeがuser_answerまたは確定規則の場合のみ許可（Validatorで検査）"
          }
        }
      }
    },
    {
      "if": { "properties": { "operation": { "const": "confirm_slot" } } },
      "then": {
        "required": ["old_status", "new_status"],
        "properties": {
          "old_status": { "enum": ["proposed"] },
          "new_status": { "const": "confirmed" },
          "evidence": {
            "properties": {
              "type": { "enum": ["user_answer", "knowledge_asset", "rule"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "operation": { "const": "mark_not_applicable" } } },
      "then": {
        "required": ["new_status"],
        "properties": { "new_status": { "const": "not_applicable" } }
      }
    },
    {
      "if": { "properties": { "operation": { "const": "revert_slot" } } },
      "then": {
        "required": ["new_status"],
        "properties": {
          "new_status": { "const": "unknown" },
          "new_value": { "const": null }
        }
      }
    }
  ]
}
