{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rimay-jp/repository-projection-mapping.schema.json",
  "title": "Repository Projection Mapping Plan",
  "description": "Repository固有文書から製品Canonicalへの写像処遇を記録するB5共通契約。原典claimはCapability Matrix、証拠未解決行の製品採否は複数の不変なB5-P batch bindingを正本参照し、本契約へ複製しない。",
  "type": "object",
  "required": [
    "contract_version",
    "plan_id",
    "repository_document_schema_version",
    "capability_matrix_binding",
    "mappings"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "const": "0.4.0" },
    "plan_id": {
      "type": "string",
      "pattern": "^RPM-[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "repository_document_schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "capability_matrix_binding": { "$ref": "#/$defs/capabilityMatrixBinding" },
    "product_adoption_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/productAdoptionBinding" }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mapping" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "canonicalPointer": {
      "type": "string",
      "description": "RFC 6901 JSON Pointer。単一ノードを指し、wildcardを許さない。",
      "pattern": "^(/([^/~*]|~[01])*)+$"
    },
    "artifactRef": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
        },
        "selector": { "type": "string", "minLength": 1 }
      }
    },
    "artifactRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactRef" }
    },
    "capabilityMatrixBinding": {
      "type": "object",
      "required": [
        "path",
        "matrix_version",
        "capability_signature",
        "classification_signature"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "reports/compatibility/rimay-capability-matrix.yaml"
        },
        "matrix_version": { "type": "string", "minLength": 1 },
        "capability_signature": { "$ref": "#/$defs/sha256" },
        "classification_signature": { "$ref": "#/$defs/sha256" }
      }
    },
    "productAdoptionBinding": {
      "type": "object",
      "required": [
        "contract_version",
        "plan_id",
        "capability_signature",
        "product_signature"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "enum": ["0.2.0", "0.3.0"] },
        "plan_id": {
          "type": "string",
          "pattern": "^RPADP-[A-Za-z0-9][A-Za-z0-9-]*$"
        },
        "capability_signature": { "$ref": "#/$defs/sha256" },
        "product_signature": { "$ref": "#/$defs/sha256" }
      }
    },
    "repositorySelector": {
      "type": "object",
      "required": ["record_kind", "rule_ids"],
      "additionalProperties": false,
      "properties": {
        "record_kind": {
          "enum": [
            "requirement",
            "response_structure",
            "atomic_response",
            "action",
            "condition_structure",
            "trigger",
            "declaration",
            "instance",
            "linking_reference"
          ]
        },
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "structural_predicate": { "$ref": "#/$defs/structuralPredicate" }
      }
    },
    "residualOnMismatch": {
      "type": "object",
      "required": ["behavior", "mapping_id"],
      "additionalProperties": false,
      "properties": {
        "behavior": { "const": "preserve_entire_record" },
        "mapping_id": {
          "type": "string",
          "pattern": "^RPMAP-[A-Za-z0-9][A-Za-z0-9-]*$"
        }
      }
    },
    "structuralPredicate": {
      "type": "object",
      "required": [
        "executable_selector_ref",
        "exact_rule_cardinality",
        "all_leaves_must_match",
        "residual_on_mismatch"
      ],
      "additionalProperties": false,
      "properties": {
        "executable_selector_ref": { "$ref": "#/$defs/artifactRef" },
        "exact_rule_cardinality": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "all_leaves_must_match": { "const": true },
        "residual_on_mismatch": { "$ref": "#/$defs/residualOnMismatch" }
      }
    },
    "capabilityRefs": {
      "type": "object",
      "required": ["primary", "supporting"],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^CAP-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "supporting": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CAP-[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        }
      }
    },
    "fixtureRefs": {
      "type": "object",
      "required": ["positive", "negative", "boundary", "ambiguity"],
      "additionalProperties": false,
      "properties": {
        "positive": { "$ref": "#/$defs/artifactRefs" },
        "negative": { "$ref": "#/$defs/artifactRefs" },
        "boundary": { "$ref": "#/$defs/artifactRefs" },
        "ambiguity": { "$ref": "#/$defs/artifactRefs" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["implementation_refs", "validator_refs", "fixture_refs"],
      "additionalProperties": false,
      "properties": {
        "implementation_refs": { "$ref": "#/$defs/artifactRefs" },
        "validator_refs": { "$ref": "#/$defs/artifactRefs" },
        "fixture_refs": { "$ref": "#/$defs/fixtureRefs" }
      }
    },
    "extensionBundle": {
      "type": "object",
      "required": [
        "target_schema_version",
        "schema_ref",
        "migration_ref",
        "store_replay_ref",
        "rollback_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "target_schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "schema_ref": { "$ref": "#/$defs/artifactRef" },
        "migration_ref": { "$ref": "#/$defs/artifactRef" },
        "store_replay_ref": { "$ref": "#/$defs/artifactRef" },
        "rollback_ref": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^REPOSITORY_MAPPING_[A-Z0-9_]+$"
        },
        "severity": { "const": "blocking" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "mapping": {
      "type": "object",
      "required": [
        "mapping_id",
        "repository_selectors",
        "capability_refs",
        "treatment",
        "canonical_targets",
        "semantic_relation",
        "validation_strength",
        "compatibility_modes",
        "rationale",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "mapping_id": {
          "type": "string",
          "pattern": "^RPMAP-[A-Za-z0-9][A-Za-z0-9-]*$"
        },
        "repository_selectors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repositorySelector" }
        },
        "capability_refs": { "$ref": "#/$defs/capabilityRefs" },
        "treatment": {
          "enum": [
            "existing_canonical",
            "canonical_extension_candidate",
            "repository_preserved_only",
            "explicitly_excluded"
          ]
        },
        "canonical_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonicalPointer" }
        },
        "semantic_relation": {
          "enum": ["exact", "normalized", "extended", "incompatible", "unknown"]
        },
        "validation_strength": {
          "enum": ["syntax_only", "linked", "semantic", "domain_validated"]
        },
        "compatibility_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["repository_compatible", "rimay_jp_enhanced"]
          }
        },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "extension_bundle": { "$ref": "#/$defs/extensionBundle" },
        "diagnostic": { "$ref": "#/$defs/diagnostic" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "treatment": { "const": "existing_canonical" } },
            "required": ["treatment"]
          },
          "then": {
            "properties": {
              "canonical_targets": { "minItems": 1 },
              "semantic_relation": { "enum": ["exact", "normalized"] },
              "validation_strength": { "enum": ["semantic", "domain_validated"] },
              "evidence": {
                "properties": {
                  "implementation_refs": { "minItems": 1 },
                  "validator_refs": { "minItems": 1 },
                  "fixture_refs": {
                    "properties": {
                      "positive": { "minItems": 1 },
                      "negative": { "minItems": 1 }
                    }
                  }
                }
              }
            },
            "not": {
              "anyOf": [
                { "required": ["extension_bundle"] },
                { "required": ["diagnostic"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "treatment": { "const": "canonical_extension_candidate" }
            },
            "required": ["treatment"]
          },
          "then": {
            "required": ["extension_bundle"],
            "properties": {
              "canonical_targets": { "minItems": 1 },
              "semantic_relation": { "const": "extended" },
              "validation_strength": { "enum": ["semantic", "domain_validated"] },
              "evidence": {
                "properties": {
                  "implementation_refs": { "minItems": 1 },
                  "validator_refs": { "minItems": 1 },
                  "fixture_refs": {
                    "properties": {
                      "positive": { "minItems": 1 },
                      "negative": { "minItems": 1 },
                      "boundary": { "minItems": 1 },
                      "ambiguity": { "minItems": 1 }
                    }
                  }
                }
              }
            },
            "not": { "required": ["diagnostic"] }
          }
        },
        {
          "if": {
            "properties": {
              "treatment": { "const": "repository_preserved_only" }
            },
            "required": ["treatment"]
          },
          "then": {
            "required": ["diagnostic"],
            "properties": {
              "canonical_targets": { "maxItems": 0 },
              "evidence": {
                "properties": {
                  "implementation_refs": { "minItems": 1 },
                  "validator_refs": { "minItems": 1 },
                  "fixture_refs": {
                    "properties": {
                      "positive": { "minItems": 1 },
                      "negative": { "minItems": 1 }
                    }
                  }
                }
              }
            },
            "not": { "required": ["extension_bundle"] }
          }
        },
        {
          "if": {
            "properties": {
              "treatment": { "const": "explicitly_excluded" }
            },
            "required": ["treatment"]
          },
          "then": {
            "required": ["diagnostic"],
            "properties": { "canonical_targets": { "maxItems": 0 } },
            "not": { "required": ["extension_bundle"] }
          }
        }
      ]
    }
  }
}
