{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rimay-jp/vocabulary-context.schema.json",
  "title": "Vocabulary Context v1.0.0",
  "type": "object",
  "required": ["context_version", "project_id", "project", "organization"],
  "additionalProperties": false,
  "properties": {
    "context_version": {"const": "1.0.0"},
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "project": {"$ref": "#/$defs/binding"},
    "organization": {"$ref": "#/$defs/binding"}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "required": ["scope", "snapshot_id", "content_hash", "source_ref"],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "pattern": "^(project:[A-Za-z0-9][A-Za-z0-9._-]*|org:common)$"
        },
        "snapshot_id": {"type": "string"},
        "content_hash": {"type": "string", "pattern": "^sha256:"},
        "source_ref": {
          "type": "string",
          "pattern": "^vocabulary(?:-fixture)?://"
        }
      }
    }
  }
}
