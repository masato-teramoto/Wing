{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "term-occurrence.schema.json",
  "title": "Term Occurrence v1.0.0",
  "description": "未知語・要確認語の出現記録（ADR-0014 D1: 不変イベント。状態を持たない。解決状況は terminology-lifecycle.yaml の Term Resolution レコードが別管理する）。生成はTerminology Orchestratorの明示操作のみ（D2: Normalizer/Extractorは terminology_observations を戻り値で返すだけで書き込まない）。findingメッセージの解析による再構成は禁止。",
  "type": "object",
  "required": ["occurrence_id", "surface_form", "observed_at", "channel", "source", "expected_types"],
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "案件別ストアでの所有案件。0.1.x記録には存在しないread互換フィールド"
    },
    "occurrence_id": {
      "type": "string",
      "pattern": "^TO-[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "surface_form": { "type": "string", "minLength": 1 },
    "normalized_surface": { "type": "string" },
    "observed_at": {
      "type": "string",
      "description": "ISO 8601。Orchestratorが永続化時に付与（純粋検出層は時刻を持たない）"
    },
    "channel": {
      "enum": ["normalizer", "extractor", "dialogue", "document"],
      "description": "検出経路。document（文書Term Extractor）はP1"
    },
    "source": {
      "type": "object",
      "required": ["document_id"],
      "additionalProperties": false,
      "properties": {
        "document_id": { "type": "string" },
        "section_id": { "type": "string" },
        "span": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          }
        },
        "excerpt_hash": {
          "type": "string",
          "description": "sha256:... 周辺文の同一性検証用（原文の再掲は避けhashで照合）"
        }
      }
    },
    "requirement_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement_id": { "type": "string" },
        "target_path": {
          "type": "string",
          "description": "この表層が束縛されるはずだったCanonical Pointer"
        }
      }
    },
    "expected_types": {
      "type": "array",
      "items": { "enum": ["actor", "class", "property", "value", "function", "rule"] },
      "description": "構文位置から期待される用語type候補（用語辞書のtype語彙と同一）"
    }
  }
}
